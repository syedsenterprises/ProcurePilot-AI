# ========================================================
# ProcurePilot AI — Environment Configuration Template
# ========================================================
# Copy this file to .env.local and populate the keys.
# DO NOT commit real secrets or credentials to source control.

# --------------------------------------------------------
# 1. Google Gemini Generative AI (Server-Side)
# --------------------------------------------------------
# Obtain your Gemini API Key at https://aistudio.google.com/
# If left empty, ProcurePilot will run in Stage 1/2 Heuristic Engine mode
# with transparent indicators.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# --------------------------------------------------------
# 2. Security & Human Approval Signatures
# --------------------------------------------------------
# Used for HMAC-SHA256 signature verification of human approval challenges
APPROVAL_SECRET=your_secure_random_approval_hmac_secret_here

# --------------------------------------------------------
# 3. PayPal Sandbox Integration (Server-Side)
# --------------------------------------------------------
# Obtain sandbox credentials at https://developer.paypal.com/dashboard/
# Keep credentials strictly server-side; client never touches these.
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox

# --------------------------------------------------------
# 4. PayPal Webhooks (Server-Side)
# --------------------------------------------------------
# Obtained after creating a webhook in the PayPal Developer Dashboard
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# --------------------------------------------------------
# 5. Application URL
# --------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------
# 6. PostgreSQL Database (Server-Side Only - Phase 1B.1)
# --------------------------------------------------------
# Use a unified connection URL or individual parameters:
# DATABASE_URL=postgresql://procurepilot_app:your_secure_password@localhost:5432/procurepilot
PGHOST=localhost
PGPORT=5432
PGDATABASE=procurepilot
PGUSER=procurepilot_app
PGPASSWORD=your_secure_postgres_password_here
PGSSL=false
PGMAXCONNECTIONS=20
PGIDLETIMEOUT=30000
PGCONNECTTIMEOUT=5000

